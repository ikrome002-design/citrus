# --------------------------------------------------
# Citrus / Laravel / Vue / TypeScript / Vite
# --------------------------------------------------

# PHP dependencies
/vendor/

# Node dependencies
/node_modules/

# Laravel environment files
.env
.env.*
!.env.example

# Laravel generated key files
/storage/*.key

# Laravel storage, cache, logs, sessions, views
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
/storage/pail

# Keep Laravel placeholder files
!/storage/logs/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/bootstrap/cache/.gitignore

# Public build and local development files
/public/build/
/public/hot
/public/storage

# Laravel public path alternatives
/public_html/storage
/public_html/hot

# Testing and coverage
.phpunit.result.cache
/coverage/
/tests/Browser/screenshots/
/tests/Browser/console/

# Laravel Homestead / Vagrant
Homestead.json
Homestead.yaml
/.vagrant

# Authentication / Composer credentials
auth.json

# Local databases
/database/*.sqlite
/database/*.sqlite-journal

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite
.vite/

# TypeScript
*.tsbuildinfo

# PHP tooling
.phpactor.json

# IDE files
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Logs
*.log

# Backup files
*.bak
*.backup

# Deployment artifacts
/deploy/
/releases/

# Docker local overrides
docker-compose.override.yml

# Secrets and certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# Local uploads and generated files
/public/uploads/
/storage/app/private/
/storage/app/public/generated/
